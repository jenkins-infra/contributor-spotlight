{
    "name": "contributor-spotlight",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "prebuild": "node scripts/build-contributors.js",
        "dev": "node scripts/build-contributors.js && vite-react-ssg dev",
        "build": "vite-react-ssg build",
        "lint": "eslint .",
        "preview": "vite preview",
        "format": "prettier . --write",
        "info": "vite info"
    },
    "dependencies": {
        "@asciidoctor/core": "^4.0.7",
        "fuse.js": "^7.5.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "lucide-react": "^0.562.0",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^6.30.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.8.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.7.0",
        "vite": "^8.2.0",
        "vite-plugin-sitemap": "^0.8.2",
        "vite-react-ssg": "^0.9.2"
    },
    "lint-staged": {
        "*.{js,jsx}": "eslint --cache --fix",
        "*.{js,jsx,css,md}": "prettier --write"
